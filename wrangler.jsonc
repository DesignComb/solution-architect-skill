{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solution-architect-skill",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "sas.dco.tw", "custom_domain": true }
  ]
}
